{
  "backbone": {
    "in_channels": 1,
    "base_channels": 64,
    "num_stages": 4,
    "num_radial_rings": 8,
    "embedding_dim": 256,
    "num_scales": 4,
    "cross_scale_heads": 8,
    "dropout": 0.1,
    "use_gcn": true,
    "use_radial_conv": true,
    "use_cross_scale_attention": true
  },
  "physics": {
    "dsar_dim": 256,
    "gamma_eps": 1e-06,
    "snr_patch_size": 7,
    "fisher_rao_eps": 1e-08,
    "gamma_mle_iters": 20,
    "use_dsar": true,
    "use_fisher_rao": true,
    "use_snr": true
  },
  "hippocampus": {
    "embedding_dim": 256,
    "sqaa_hidden": 128,
    "apm_hidden": 128,
    "apm_layers": 2,
    "agppi_scale": 1.0,
    "bpc_prior_var": 1.0,
    "bpc_noise_var": 0.01,
    "use_sqaa": true,
    "use_agppi": true,
    "use_apm": true,
    "use_bpc_gp": false,
    "use_dsar_smoother": true
  },
  "memory": {
    "max_classes": 200,
    "embedding_dim": 256,
    "pim_threshold": 0.85,
    "tpe_momentum": 0.9,
    "tpe_min_count": 5
  },
  "inference": {
    "novelty_threshold": 0.5,
    "platt_temperature": 1.0,
    "platt_bias": 0.0,
    "top_k": 5
  },
  "training": {
    "phase1_epochs": 50,
    "phase1_lr": 0.001,
    "phase1_batch_size": 32,
    "phase1_num_workers": 4,
    "agcp_temperature": 0.07,
    "agcp_margin": 0.5,
    "phase2_epochs": 150,
    "phase2_episodes_per_epoch": 600,
    "phase2_lr": 0.0003,
    "phase2_batch_size": 1,
    "phase2_num_workers": 4,
    "n_way": 5,
    "k_shot": 5,
    "n_query": 15,
    "piam_lambda_physics": 0.1,
    "piam_lambda_proto": 1.0,
    "piam_lambda_novelty": 0.1,
    "weight_decay": 0.0001,
    "grad_clip": 5.0,
    "warmup_epochs": 5,
    "scheduler": "cosine",
    "step_lr_gamma": 0.5,
    "step_lr_step": 20,
    "checkpoint_dir": "checkpoints",
    "log_dir": "logs",
    "log_interval": 1,
    "eval_interval": 5,
    "seed": 4
  },
  "ablation": {
    "use_radial_conv": true,
    "use_cross_scale_attention": true,
    "use_gcn": true,
    "use_dsar": true,
    "use_fisher_rao": true,
    "use_snr": true,
    "use_sqaa": true,
    "use_agppi": true,
    "use_apm": true,
    "use_bpc_gp": false,
    "use_dsar_smoother": true,
    "use_pim": true,
    "use_tpe": true,
    "use_novelty": true
  },
  "device": "cuda"
}